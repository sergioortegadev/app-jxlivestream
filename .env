# Para back en local, colocar puerto, para server remoto no.
# HOST=http://192.168.100.211:8000
# HOST=localhost
HOST=https://back-jxlivestream.onrender.com

RETRY_DELAY_MS=2500
MAX_RETRIES=10
# Tiempo de espera luego de los 10 reintentos de conectar fallidos.
POLLING_INTERVAL_MS=15000 

# 'http' | 'rtmp' | 'websocket'
ADAPTER_TYPE=http
